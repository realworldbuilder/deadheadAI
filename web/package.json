{
  "name": "nethead-web",
  "private": true,
  "type": "module",
  "description": "The Nethead notesfile — the Dead conference, back up, with a tape deck at the bottom.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply nethead-notes --local",
    "migrate": "wrangler d1 migrations apply nethead-notes --remote",
    "types": "wrangler types",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "size": "node scripts/size-gate.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "hono": "^4.13.7",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
